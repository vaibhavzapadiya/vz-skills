{
  "name": "vz-skills",
  "version": "0.2.0",
  "description": "VZ Skills: an evidence-driven development lifecycle plugin for Claude Code (discovery, profiles, clarify/plan/implement/test/review/verify, advisory guards). Install with `npx vz-skills install`.",
  "keywords": [
    "claude-code",
    "claude",
    "plugin",
    "skills",
    "agent",
    "workflow",
    "code-review",
    "security"
  ],
  "license": "MIT",
  "author": "Vaibhav Zapadiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaibhavzapadiya/vz-skills.git"
  },
  "homepage": "https://github.com/vaibhavzapadiya/vz-skills#readme",
  "bugs": {
    "url": "https://github.com/vaibhavzapadiya/vz-skills/issues"
  },
  "bin": {
    "vz-skills": "bin/vz-skills.js"
  },
  "files": [
    "bin/",
    "plugins/vz-skills/",
    ".claude-plugin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:structure": "node --test tests/structure.test.js",
    "test:config": "node --test tests/config.test.js",
    "test:discovery": "node --test tests/discovery.test.js",
    "test:hooks": "node --test tests/hooks.test.js",
    "test:platform": "node --test tests/platform.test.js",
    "validate": "node plugins/vz-skills/scripts/vz-validate.js",
    "validate:claude": "claude plugin validate ./plugins/vz-skills --strict",
    "discover": "node plugins/vz-skills/scripts/vz-discover.js",
    "config": "node plugins/vz-skills/scripts/vz-config.js",
    "package": "node scripts/package-release.js",
    "prepack": "node scripts/gen-catalog.js --check && node scripts/gen-config-schema.js --check && node plugins/vz-skills/scripts/vz-validate.js plugins/vz-skills"
  }
}
