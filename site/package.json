{
  "name": "vz-skills-site",
  "private": true,
  "version": "0.1.1",
  "description": "Landing page and documentation website for VZ Toolkit (Vite, React, TypeScript, Tailwind CSS, MDX).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-changelog.mjs && node scripts/build-search-index.mjs && vite",
    "build": "node scripts/sync-changelog.mjs && node scripts/build-search-index.mjs && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node scripts/verify-content.mjs",
    "verify": "npm run sync && npm run typecheck && npm run check && npm run build",
    "sync": "node scripts/sync-changelog.mjs && node scripts/build-search-index.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/hast": "3.0.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "vite": "7.3.7"
  }
}
